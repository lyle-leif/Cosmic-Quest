@startuml
title Cosmic Quest Class Diagram v1
skinparam classAttributeIconSize 0
left to right direction
' <<S03>> and similar mark classes that are planned for that session.

package model {

    interface Combatant {
        + takeDamage(amount: int): void
        + isDefeated(): boolean
        + getHp(): int
        + getMaxHp(): int
    }

    enum QuestionType {
        IDENTIFICATION
        REASONING
        MULTIPLE_CHOICE
        ENUMERATION
    }

    abstract class Entity implements Combatant {
        - name: String
        - level: int
        - hp: int
        - maxHp: int
        - attackPower: int
        # Entity(name: String, level: int, hp: int, maxHp: int, attackPower: int)
        + takeDamage(amount: int): void
        + isDefeated(): boolean
        + attack(target: Combatant): void
        + {abstract} getQuestionType(): QuestionType
        + {abstract} getSpecialMove(): String
    }

    class VoidBrute extends Entity {
        + VoidBrute(level: int)
    }
    class StarWeaver extends Entity {
        + StarWeaver(level: int)
    }
    class NebulaLich extends Entity {
        + NebulaLich(level: int)
    }
    class LunarBeast extends Entity {
        + LunarBeast(level: int)
    }

    class Player implements Combatant {
        - {static} STARTING_HP: int = 100
        - name: String
        - maxHp: int
        - hp: int
        - score: int
        - streak: int
        - shieldTurns: int
        - powerUps: List<PowerUp> (S06)
        + Player(name: String)
        + takeDamage(amount: int): void
        + isDefeated(): boolean
        + heal(amount: int): void
        + activateShield(turns: int): void
        + addScore(points: int): void
        + increaseStreak(): void
        + resetStreak(): void
    }

    abstract class Question <<S03>> {
        - questionText: String
        - correctAnswer: String
        - difficulty: int
        # Question(questionText: String, correctAnswer: String, difficulty: int)
        + {abstract} checkAnswer(input: String): boolean
        + {abstract} getType(): QuestionType
        # {static} normalize(s: String): String
    }

    class IdentificationQuestion <<S03>> extends Question
    class MultipleChoiceQuestion <<S03>> extends Question {
        - options: List<String>
        - correctIndex: int
    }
    class EnumerationQuestion <<S04>> extends Question {
        - items: List<String>
        + getMatchRatio(input: String): double
    }
    class ReasoningQuestion <<S04>> extends Question {
        - {static} KEYWORD_PASS_RATIO: double = 0.6
        - keywords: List<String>
    }

    abstract class PowerUp <<S06>> {
        - name: String
        - description: String
        + {abstract} apply(p: Player, b: BattleMode): void
    }
    class Shield <<S06>> extends PowerUp
    class Hint <<S06>> extends PowerUp
    class DoubleDamage <<S06>> extends PowerUp
    class Repair <<S06>> extends PowerUp

    class Team <<S07>> {
        - name: String
        - players: List<Player>
        + addPlayer(p: Player): void
        + isDefeated(): boolean
        + getNextAlivePlayer(): Player
    }
}

package logic {

    class Term <<S03>> {
        - term: String
        - definition: String
    }

    class LessonData <<S03>> {
        - terms: List<Term>
        - enumerations: Map<String, List<String>>
    }

    class TxtParser <<S03>> {
        + parseFile(path: Path): LessonData
    }

    class QuestionGenerator <<S04>> {
        - data: LessonData
        + QuestionGenerator(data: LessonData)
        + generateQuestions(count: int): List<Question>
    }

    class QuestionPool <<S05>> {
        - questions: ArrayDeque<Question>
        - missed: List<Question>
        + getNextQuestion(): Question
        + recordMissedQuestion(q: Question): void
        + hasNext(): boolean
        + getMissedQuestions(): List<Question>
    }

    class DamageCalculator <<S05>> {
        - {static} BASE_DAMAGE: int = 20
        - {static} STREAK_BONUS: double = 0.10
        - {static} MAX_STREAK_BONUS: double = 0.50
        + playerDamage(difficulty: int, streak: int): int
        + enemyDamage(e: Entity): int
    }

    enum BattleState <<S06>> {
        QUESTION
        PLAYER_ATTACK
        ENEMY_ATTACK
        WON
        LOST
    }

    class TurnResult <<S06>> {
        - correct: boolean
        - damageDealt: int
        - damageTaken: int
        - newState: BattleState
    }

    abstract class BattleMode <<S06>> {
        - questionPool: QuestionPool
        - entity: Entity
        - currentTurn: int
        - state: BattleState
        # stats: MatchStats
        + startBattle(): void
        + getCurrentQuestion(): Question
        + {abstract} submitAnswer(answer: String): TurnResult
        + nextTurn(): void
        + endBattle(): void
    }

    class SoloBossBattle <<S06>> extends BattleMode {
        - player: Player
        + submitAnswer(answer: String): TurnResult
    }

    class SquadBossBattle <<S07>> extends BattleMode {
        - team: Team
        + submitAnswer(answer: String): TurnResult
    }

    class MatchStats <<S07>> {
        - correctAnswers: int
        - totalAnswers: int
        - damageDealt: int
        - damageTaken: int
        - missed: List<Question>
        - playerAnswers: List<String>
        + recordAnswer(q: Question, answer: String, correct: boolean, damage: int): void
        + getStars(): int
        + displayResults(): String
    }
}

package ai {
    interface QuestionProvider <<S08>> {
        + generate(data: LessonData): List<Question>
    }
    class LocalProvider <<S08>> implements QuestionProvider
    class GeminiProvider <<S08>> implements QuestionProvider
}

' Uses an enum
Entity ..> QuestionType
Question ..> QuestionType

' Lesson file to questions
TxtParser ..> LessonData : creates
LessonData *-- "*" Term : contains
QuestionGenerator --> "1" LessonData : reads
QuestionGenerator ..> Question : creates
QuestionPool o-- "*" Question : holds

' Battle
BattleMode --> "1" QuestionPool
BattleMode --> "1" Entity : fights
BattleMode --> "1" BattleState
BattleMode *-- "1" MatchStats
BattleMode ..> DamageCalculator : uses
BattleMode ..> TurnResult : returns
SoloBossBattle --> "1" Player
SquadBossBattle --> "1" Team
Team o-- "1..3" Player
Player o-- "0..3" PowerUp : holds
PowerUp ..> BattleMode : changes
MatchStats --> "*" Question : missed

' AI
LocalProvider ..> QuestionGenerator : uses
@enduml